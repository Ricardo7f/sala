rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do usuário: só o próprio dono pode ler/criar/editar o seu.
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reservas da sala de reunião.
    // - Qualquer usuário logado pode LER (precisa ver o calendário inteiro).
    // - Só pode CRIAR uma reserva em seu próprio nome (userId == quem está logado).
    // - Só pode APAGAR (cancelar) as reservas que ele mesmo criou.
    // - Não é permitido EDITAR uma reserva já existente (cancela e cria de novo).
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow update: if false;
    }
  }
}
